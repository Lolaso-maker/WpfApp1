<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WpfApp1"
                    xmlns:m="clr-namespace:WpfApp1.Modelos">

    <!--
        Estilos compartidos por todas las ventanas de GameStation.
        Se cargan en App.xaml, así que cualquier ventana o vista puede usarlos.
    -->

    <!-- ═══════════════════════ PALETA ═══════════════════════ -->

    <SolidColorBrush x:Key="BgBrush" Color="#0B0D12"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#0E1016"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#131722"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#181D2A"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1A1F2C"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1F2432"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#2E3445"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A9B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7D8497"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#A996FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E1A38"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#14301F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C7A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1822"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9373FF" Offset="0"/>
        <GradientStop Color="#6242F0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Iconos de Windows 11 (con respaldo para Windows 10) -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <local:VisibleSi x:Key="VisibleSi"/>
    <local:EnumABool x:Key="EnumABool"/>


    <!-- ═══════════════════════ PORTADAS ═══════════════════════ -->

    <LinearGradientBrush x:Key="PortadaBuscaminas" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8A4C" Offset="0"/>
        <GradientStop Color="#C0265E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaEclipse" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7B5CFF" Offset="0"/>
        <GradientStop Color="#2B1A6E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaNeon" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16B9D8" Offset="0"/>
        <GradientStop Color="#1B2A6B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaHorizon" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8FA3BF" Offset="0"/>
        <GradientStop Color="#1E293B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaWildlands" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3CC577" Offset="0"/>
        <GradientStop Color="#124A38" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaKingdoms" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2B544" Offset="0"/>
        <GradientStop Color="#76391A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaVoid" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#111633" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaOceanfall" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EC4B6" Offset="0"/>
        <GradientStop Color="#0E4558" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PortadaAfterlight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7DB4" Offset="0"/>
        <GradientStop Color="#58296B" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="CoverSheen" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#40FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CoverShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.45"/>
        <GradientStop Color="#66000000" Offset="1"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════ FOCO DE TECLADO ═══════════════════════ -->

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="12"
                               RadiusY="12"
                               Stroke="{StaticResource AccentLightBrush}"
                               StrokeThickness="2"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════ SCROLLBAR FINA ═══════════════════════ -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#262C3B" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A4256"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#7C5CFC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Margin="2,4"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Margin="4,2"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ═══════════════════════ TOOLTIP ═══════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1C2130"
                            BorderBrush="#2C3344"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════ BARRA DE PROGRESO ═══════════════════════ -->

    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="#252A38"/>
        <Setter Property="Foreground" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════ TEXTOS ═══════════════════════ -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#5F6679"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="14,0,0,8"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SectionSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Tarjeta / panel -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Número grande de las estadísticas -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>


    <!-- ═══════════════════════ MENÚ LATERAL ═══════════════════════ -->

    <!-- Elemento seleccionable del menú (Tag = icono) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Navegacion"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="14,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Icon"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="0,0,2,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                        </Border>

                        <Border x:Name="Indicator"
                                Width="3"
                                Height="18"
                                CornerRadius="2"
                                Background="{StaticResource AccentGradient}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Opacity="0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#151925"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón con el mismo aspecto que el menú (Tag = icono) -->
    <Style x:Key="SideButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="14,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#151925"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1B2030"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideDangerButton" TargetType="Button" BasedOn="{StaticResource SideButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ═══════════════════════ BOTONES ═══════════════════════ -->

    <Style x:Key="TopNavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#161A24"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1C2130"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#171B26"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2331"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón sin aspecto propio (para hacer clicable cualquier contenido) -->
    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#151925"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow"
                                CornerRadius="12"
                                Background="{StaticResource AccentBrush}"
                                Opacity="0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C5CFC"
                                                  BlurRadius="24"
                                                  ShadowDepth="6"
                                                  Direction="270"
                                                  Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource AccentGradient}"/>
                        <Border x:Name="Shine" CornerRadius="12" Background="White" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shine" Property="Opacity" Value="0.1"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shine" Property="Opacity" Value="0"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Glow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimarySmallButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="12"
                            Background="#1AFFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón secundario sobre superficies oscuras -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="10"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1C2232"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FF8FA3"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ═══════════════════════ FILTROS (CHIPS) ═══════════════════════ -->

    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="16,7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4155"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#241D45"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#D4CAFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════ CAMPOS DE TEXTO ═══════════════════════ -->

    <!-- Buscador (Tag = texto de ayuda) -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentLightBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <Grid Margin="14,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SearchIcon"
                                       Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>

                            <TextBlock x:Name="Placeholder"
                                       Grid.Column="1"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <Border x:Name="Shortcut"
                                    Grid.Column="2"
                                    Background="#1C2130"
                                    BorderBrush="#2A3040"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                                <TextBlock Text="Ctrl K"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="#161A27"/>
                            <Setter TargetName="SearchIcon" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                            <Setter TargetName="Shortcut" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de texto normal (Tag = texto de ayuda) -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentLightBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <Grid Margin="12,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="Placeholder"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════ INTERRUPTOR (CheckBox) ═══════════════════════ -->

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    CornerRadius="12"
                                    Background="#2A3040"
                                    BorderBrush="#3A4256"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Knob"
                                     Width="16"
                                     Height="16"
                                     Fill="#C9CDD6"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradient}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#4A5368"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════ TARJETA DE JUEGO ═══════════════════════ -->

    <!-- El DataContext del botón es un Modelos.Juego -->
    <Style x:Key="GameCard" TargetType="Button">
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Root no se mueve: así el ratón no "pierde" la tarjeta al elevarse -->
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid x:Name="Lift">
                            <Grid.RenderTransform>
                                <TranslateTransform/>
                            </Grid.RenderTransform>

                            <Border x:Name="Glow"
                                    CornerRadius="16"
                                    Background="{StaticResource BgBrush}"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="32"
                                                      ShadowDepth="12"
                                                      Direction="270"
                                                      Color="#000000"
                                                      Opacity="0.7"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Card"
                                    CornerRadius="16"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border CornerRadius="15,15,0,0" Background="{Binding Portada}"/>
                                    <Border CornerRadius="15,15,0,0" Background="{StaticResource CoverSheen}"/>
                                    <Border CornerRadius="15,15,0,0" Background="{StaticResource CoverShade}"/>

                                    <TextBlock Text="{Binding Glifo}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="88"
                                               Foreground="White"
                                               Opacity="0.22"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,14,12"/>

                                    <Border x:Name="Badge"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Padding="8,3"
                                            CornerRadius="6"
                                            Background="#73000000">
                                        <TextBlock Text="{Binding Estado}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>

                                    <TextBlock x:Name="Heart"
                                               Text="&#xEB52;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Foreground="#FF7DB4"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Margin="0,14,14,0"
                                               Visibility="{Binding EnListaDeseos, Converter={StaticResource VisibleSi}}"
                                               ToolTip="En tu lista de deseos"/>

                                    <!-- Capa al pasar el ratón -->
                                    <Border x:Name="Overlay"
                                            CornerRadius="15,15,0,0"
                                            Background="#59000000"
                                            Opacity="0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="56" Height="56">
                                                <Ellipse x:Name="OverlayCircle" Fill="White"/>
                                                <TextBlock x:Name="OverlayIcon"
                                                           Text="&#xE768;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="20"
                                                           Foreground="#0B0D12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="3,0,0,0"/>
                                            </Grid>
                                            <TextBlock x:Name="OverlayText"
                                                       Text="Jugar"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Información -->
                                    <StackPanel Grid.Row="1" Margin="16,14,16,16">
                                        <TextBlock Text="{Binding Titulo}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Generos}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FooterIcon"
                                                       Text="&#xE823;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding HorasTexto}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="6,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Percent"
                                                       Grid.Column="2"
                                                       Text="{Binding ProgresoTexto}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentLightBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <ProgressBar x:Name="Bar"
                                                     Style="{StaticResource ThinProgress}"
                                                     Value="{Binding Progreso, Mode=OneWay}"
                                                     Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="INSTALADO">
                            <Setter TargetName="Badge" Property="Background" Value="#E622A35A"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Jugable}" Value="False">
                            <Setter TargetName="OverlayIcon" Property="Text" Value="&#xE823;"/>
                            <Setter TargetName="OverlayIcon" Property="Margin" Value="0"/>
                            <Setter TargetName="OverlayText" Property="Text" Value="Próximamente"/>
                            <Setter TargetName="Percent" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Hidden"/>
                        </DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="#5A4BB0"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-6"
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0"
                                                         Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Overlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="#171C28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La tarjeta bajo el ratón se dibuja por encima de sus vecinas -->
    <Style x:Key="CardContainer" TargetType="ContentPresenter">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ═══════════════════════ ENTRADA DE ACTIVIDAD ═══════════════════════ -->

    <!-- Una entrada del historial (historial y notificaciones) -->
    <DataTemplate x:Key="EntradaActividad">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Top">
                <Ellipse x:Name="Fondo" Fill="{StaticResource AccentSoftBrush}"/>
                <TextBlock x:Name="Glifo" Text="{Binding Glifo}" Style="{StaticResource Icon}" FontSize="15"
                           Foreground="{StaticResource AccentLightBrush}"/>
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,2,16,14">
                <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Detalle}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding FechaTexto}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Tipo}" Value="{x:Static m:TipoActividad.Victoria}">
                <Setter TargetName="Fondo" Property="Fill" Value="{StaticResource SuccessSoftBrush}"/>
                <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tipo}" Value="{x:Static m:TipoActividad.Logro}">
                <Setter TargetName="Fondo" Property="Fill" Value="#33FBBF24"/>
                <Setter TargetName="Glifo" Property="Foreground" Value="#FBBF24"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tipo}" Value="{x:Static m:TipoActividad.Partida}">
                <Setter TargetName="Fondo" Property="Fill" Value="{StaticResource DangerSoftBrush}"/>
                <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tipo}" Value="{x:Static m:TipoActividad.Amigo}">
                <Setter TargetName="Fondo" Property="Fill" Value="#2A60A5FA"/>
                <Setter TargetName="Glifo" Property="Foreground" Value="#60A5FA"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tipo}" Value="{x:Static m:TipoActividad.Descarga}">
                <Setter TargetName="Fondo" Property="Fill" Value="#2A22D3EE"/>
                <Setter TargetName="Glifo" Property="Foreground" Value="#22D3EE"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
