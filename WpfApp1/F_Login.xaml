<Window x:Class="WpfApp1.F_Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStation - Iniciar sesión"
        Width="480"
        Height="820"
        MinWidth="420"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0B0D12"
        Foreground="#F4F5F7">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#151923"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#7C5CFC"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F4F5F7"/>

        <SolidColorBrush x:Key="SecondaryBrush"
                         Color="#8B91A1"/>

        <Style x:Key="InputStyle"
               TargetType="TextBox">

            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="BorderBrush" Value="#303647"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#7C5CFC"/>
            <Setter Property="Foreground" Value="White"/>

        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Border Background="#11141C"
                BorderBrush="#272C38"
                BorderThickness="1"
                CornerRadius="20"
                Padding="30">

            <StackPanel VerticalAlignment="Center">

                <!-- LOGO -->

                <Border Width="58"
                        Height="58"
                        CornerRadius="15"
                        Background="#7C5CFC"
                        HorizontalAlignment="Center">

                    <TextBlock Text="G"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="GameStation"
                           FontSize="27"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,4"/>

                <TextBlock Text="Tu mundo de videojuegos"
                           Foreground="{StaticResource SecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Bienvenido de nuevo"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Inicia sesión para acceder a tu biblioteca."
                           Foreground="{StaticResource SecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22"/>

                <!-- USUARIO -->

                <TextBlock Text="Usuario"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="TxtUsuario"
                         Style="{StaticResource InputStyle}"
                         MaxLength="50"
                         ToolTip="Introduce tu nombre de usuario"/>

                <!-- CONTRASEÑA -->

                <TextBlock Text="Contraseña"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,18,0,8"/>

                <PasswordBox x:Name="TxtPassword"
                             Height="44"
                             Padding="12,8"
                             FontSize="14"
                             Foreground="White"
                             Background="#151923"
                             BorderBrush="#303647"
                             BorderThickness="1"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             ToolTip="Introduce tu contraseña"/>

                <!-- MENSAJE -->

                <TextBlock x:Name="TxtMensaje"
                           Text=""
                           Foreground="#FF7777"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MinHeight="34"
                           Margin="0,12,0,4"/>

                <!-- LOGIN -->

                <Button Content="INICIAR SESIÓN"
                        Style="{StaticResource ActionButton}"
                        Click="BtnLogin_Click"/>

                <!-- SALIR -->

                <Button Content="Salir"
                        Height="42"
                        Margin="0,10,0,0"
                        Background="#202431"
                        Foreground="#D5D7E0"
                        BorderBrush="#343A4B"
                        BorderThickness="1"
                        FontSize="13"
                        Cursor="Hand"
                        Click="BtnSalir_Click"/>

                <TextBlock Text="Acceso a tu biblioteca de videojuegos"
                           Foreground="#666D7E"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,22,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>