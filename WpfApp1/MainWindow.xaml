<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStasion — Game Launcher"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        Background="#0B0D12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- COLORES -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D12"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#11141C"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151923"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1E29"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#222837"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#947AFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8B91A1"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#272C38"/>

        <!-- BOTÓN SIDEBAR -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA2B1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="48"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Margin="8,2">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D2230"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#292F40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN TOPBAR -->
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA2B1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#1C202C"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TARJETA -->
        <Style x:Key="GameCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="7"/>
        </Style>

        <!-- SEARCH -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#272C38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Height" Value="42"/>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#1E222C"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>


                <!-- LOGO -->

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0">

                    <Border Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="{StaticResource AccentBrush}">

                        <TextBlock Text="G"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"><Run Text="Game"/><Run Language="es-es" Text="Station"/><Run Text=""/></TextBlock>
                </StackPanel>


                <!-- MENU -->

                <StackPanel Grid.Row="1"
                            Margin="8,15,8,0">

                    <TextBlock Text="MENÚ"
                               Foreground="#555C6C"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="18,0,0,8"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Background="#1D1930"
                            Foreground="#FFFFFF"
                            Content="▣   Biblioteca"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="◈   Mis juegos"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="★   Destacados"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="↓   Descargas"/>


                    <TextBlock Text="COMUNIDAD"
                               Foreground="#555C6C"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="18,30,0,8"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="●   Amigos"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="◉   Actividad"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="♟   Perfil"/>

                </StackPanel>


                <!-- CONFIGURACIÓN -->

                <Button Grid.Row="2"
                        Style="{StaticResource SidebarButton}"
                        Content="⚙   Configuración"
                        VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- ================= CONTENIDO ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- TOP BAR -->

            <Border Grid.Row="0"
                    Background="#0F1118"
                    BorderBrush="#1E222C"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- NAVEGACIÓN -->

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource TopButton}"
                                Content="Tienda"/>

                        <Button Style="{StaticResource TopButton}"
                                Content="Comunidad"/>

                        <Button Style="{StaticResource TopButton}"
                                Content="Soporte"/>

                    </StackPanel>


                    <!-- BUSCADOR -->

                    <Border Grid.Column="1"
                            Height="42"
                            CornerRadius="9"
                            Background="#151923"
                            BorderBrush="#272C38"
                            BorderThickness="1"
                            Margin="10,0">

                        <Grid>

                            <TextBlock Text="⌕"
                                       FontSize="20"
                                       Foreground="#686F7F"
                                       VerticalAlignment="Center"
                                       Margin="14,0"/>

                            <TextBox
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="13"
                                Padding="42,0,10,0"
                                VerticalContentAlignment="Center"
                                Text="Buscar juegos..."/>

                        </Grid>

                    </Border>


                    <!-- PERFIL -->

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#2C3345">

                            <TextBlock Text="JD"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0">

                            <TextBlock Text="Jugador"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>

                            <TextBlock Text="En línea"
                                       Foreground="#6CCB8A"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= MAIN ================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="32,28,32,40">


                    <!-- HERO -->

                    <Border Height="210"
                            CornerRadius="18"
                            Background="#1A1730"
                            Margin="0,0,0,30"
                            Clip="">

                        <Grid>

                            <!-- Fondo -->

                            <Rectangle Fill="#241D4B"/>

                            <Rectangle Fill="#7C5CFC"
                                       Opacity="0.12"
                                       HorizontalAlignment="Right"
                                       Width="500"/>


                            <StackPanel VerticalAlignment="Center"
                                        Margin="34,0">

                                <TextBlock Text="DESTACADO"
                                           Foreground="#A997FF"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Tu próxima aventura"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Margin="0,7,0,0"/>

                                <TextBlock Text="Descubre nuevos mundos y juega con tus amigos."
                                           Foreground="#A7A2BC"
                                           FontSize="14"
                                           Margin="0,7,0,18"/>

                                <Button Content="EXPLORAR TIENDA"
                                        Width="160"
                                        Height="38"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>

                            </StackPanel>


                            <!-- DECORACIÓN -->

                            <TextBlock Text="✦"
                                       FontSize="170"
                                       Foreground="#8B72FF"
                                       Opacity="0.12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,70,0"/>

                        </Grid>

                    </Border>


                    <!-- HEADER -->

                    <Grid Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Tu biblioteca"
                                       Foreground="White"
                                       FontSize="25"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Todos tus juegos en un solo lugar"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Ordenar  ▾"
                                Style="{StaticResource TopButton}"
                                VerticalAlignment="Center"/>

                    </Grid>


                    <!-- CATEGORÍAS -->

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,18">

                        <Border Background="#282044"
                                CornerRadius="7"
                                Padding="13,7"
                                Margin="0,0,8,0">

                            <TextBlock Text="Todos"
                                       Foreground="#BDAEFF"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Border>

                        <Border Background="#151923"
                                CornerRadius="7"
                                Padding="13,7"
                                Margin="0,0,8,0">

                            <TextBlock Text="Acción"
                                       Foreground="#858C9B"
                                       FontSize="12"/>
                        </Border>

                        <Border Background="#151923"
                                CornerRadius="7"
                                Padding="13,7"
                                Margin="0,0,8,0">

                            <TextBlock Text="RPG"
                                       Foreground="#858C9B"
                                       FontSize="12"/>
                        </Border>

                        <Border Background="#151923"
                                CornerRadius="7"
                                Padding="13,7"
                                Margin="0,0,8,0">

                            <TextBlock Text="Estrategia"
                                       Foreground="#858C9B"
                                       FontSize="12"/>
                        </Border>

                        <Border Background="#151923"
                                CornerRadius="7"
                                Padding="13,7">

                            <TextBlock Text="Indie"
                                       Foreground="#858C9B"
                                       FontSize="12"/>
                        </Border>

                    </StackPanel>


                    <!-- ================= JUEGOS ================= -->

                    <UniformGrid Columns="4">


                        <!-- JUEGO 1 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#493B80">

                                    <TextBlock Text="01"
                                               FontSize="42"
                                               Foreground="#FFFFFF"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Eclipse"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Acción · RPG"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- JUEGO 2 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#24516B">

                                    <TextBlock Text="02"
                                               FontSize="42"
                                               Foreground="White"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Neon City"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Aventura · Indie"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- JUEGO 3 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#75403F">

                                    <TextBlock Text="03"
                                               FontSize="42"
                                               Foreground="White"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Dark Horizon"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Acción · Shooter"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- JUEGO 4 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#35634E">

                                    <TextBlock Text="04"
                                               FontSize="42"
                                               Foreground="White"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Wildlands"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Supervivencia"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- JUEGO 5 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#594B2C">

                                    <TextBlock Text="05"
                                               FontSize="42"
                                               Foreground="White"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Kingdoms"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Estrategia"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- JUEGO 6 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#493866">

                                    <TextBlock Text="06"
                                               FontSize="42"
                                               Foreground="White"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Void"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="RPG · Fantasía"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- JUEGO 7 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#285C5A">

                                    <TextBlock Text="07"
                                               FontSize="42"
                                               Foreground="White"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Oceanfall"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Aventura"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- JUEGO 8 -->

                        <Border Style="{StaticResource GameCard}"
                                Height="205">

                            <Grid>

                                <Border Height="120"
                                        CornerRadius="14,14,0,0"
                                        Background="#633F58">

                                    <TextBlock Text="08"
                                               FontSize="42"
                                               Foreground="White"
                                               Opacity="0.25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            Margin="14,0,14,14">

                                    <TextBlock Text="Afterlight"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Indie · Historia"
                                               Foreground="#7F8797"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </UniformGrid>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
