<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStation — Game Launcher"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D12"
        Foreground="#F4F5F7"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Los estilos están en Themes/Estilos.xaml. El DataContext es Modelos.Launcher. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ═══════════════════════════════════════════════════════════
             BARRA LATERAL
             ═══════════════════════════════════════════════════════════ -->

        <Border Grid.Column="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="#171A23"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,24,20,24">
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="12" Background="{StaticResource AccentGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C5CFC" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="G" FontSize="21" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"><Run Text="Game"/><Run Text="Station" Foreground="{StaticResource AccentLightBrush}"/></TextBlock>
                        <TextBlock Text="Tu mundo de videojuegos" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Menú -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="Menu" Margin="12,4,12,12" ToggleButton.Checked="Menu_Checked">

                        <TextBlock Text="MENÚ" Style="{StaticResource SectionLabel}"/>

                        <RadioButton x:Name="NavBiblioteca" Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="Biblioteca"/>
                        <RadioButton x:Name="NavMisJuegos" Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="Mis juegos"/>
                        <RadioButton x:Name="NavDestacados" Style="{StaticResource NavItem}" Tag="&#xE734;" Content="Destacados"/>

                        <RadioButton x:Name="NavDescargas" Style="{StaticResource NavItem}" Tag="&#xE896;">
                            <Grid>
                                <TextBlock Text="Descargas" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinWidth="20" Height="18" Padding="6,0" CornerRadius="9"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="{Binding HayDescargas, Converter={StaticResource VisibleSi}}">
                                    <TextBlock Text="{Binding DescargasPendientes}" FontSize="11" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <TextBlock Text="COMUNIDAD" Style="{StaticResource SectionLabel}" Margin="14,22,0,8"/>

                        <RadioButton x:Name="NavAmigos" Style="{StaticResource NavItem}" Tag="&#xE716;">
                            <Grid>
                                <TextBlock Text="Amigos" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AmigosConectados}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavActividad" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Actividad"/>
                        <RadioButton x:Name="NavPerfil" Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="Perfil"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Parte inferior -->
                <StackPanel Grid.Row="2" Margin="12,0,12,14">

                    <!-- Descarga en curso (clic = ir a Descargas) -->
                    <Button Style="{StaticResource PlainButton}" Padding="0" Margin="2,0,2,10" Click="IrADescargas_Click"
                            ToolTip="Ver descargas">
                        <Border Padding="14" CornerRadius="14" Background="#131722"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Con una descarga activa -->
                                <StackPanel DataContext="{Binding DescargaActual}"
                                            Visibility="{Binding Converter={StaticResource VisibleSi}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentLightBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Descargando" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ProgresoTexto}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progreso, Mode=OneWay}" Margin="0,12,0,8"/>
                                    <Grid>
                                        <TextBlock Text="{Binding TamanoTexto}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding VelocidadTexto}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Sin descargas activas -->
                                <Grid Visibility="{Binding HayDescargaActiva, Converter={StaticResource VisibleSi}, ConverterParameter=no}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource SuccessSoftBrush}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Sin descargas activas" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding ResumenDescargasTexto}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <RadioButton x:Name="NavAjustes" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Configuración"
                                 Checked="Menu_Checked"/>

                    <Button Style="{StaticResource SideDangerButton}" Tag="&#xE7E8;" Content="Cerrar sesión"
                            Click="CerrarSesion_Click" ToolTip="Volver al inicio de sesión"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- ═══════════════════════════════════════════════════════════
             CONTENIDO
             ═══════════════════════════════════════════════════════════ -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="#171A23" BorderThickness="0,0,0,1">
                <Grid Margin="24,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navegación -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TopNavButton}" Content="Tienda" Tag="Destacados" Click="Seccion_Click"/>
                        <Button Style="{StaticResource TopNavButton}" Content="Comunidad" Tag="Amigos" Click="Seccion_Click"/>
                        <Button Style="{StaticResource TopNavButton}" Content="Soporte" Tag="Soporte" Click="Seccion_Click"/>
                    </StackPanel>

                    <!-- Buscador -->
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Style="{StaticResource SearchBox}"
                             Tag="Buscar en tu biblioteca…"
                             MaxWidth="440"
                             Margin="24,0"
                             VerticalAlignment="Center"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Busqueda_TextChanged"
                             ToolTip="Buscar por nombre o género (Ctrl + K)"/>

                    <!-- Notificaciones y perfil -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button x:Name="Campana" Style="{StaticResource IconButton}" Click="Campana_Click" ToolTip="Notificaciones">
                            <Grid>
                                <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="16"/>
                                <Ellipse Width="9" Height="9"
                                         Fill="{StaticResource DangerBrush}"
                                         Stroke="{StaticResource ChromeBrush}"
                                         StrokeThickness="1.5"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-3,-4,0"
                                         Visibility="{Binding HayNotificacionesSinLeer, Converter={StaticResource VisibleSi}}"/>
                            </Grid>
                        </Button>

                        <Rectangle Width="1" Height="28" Fill="{StaticResource LineBrush}" Margin="12,0" VerticalAlignment="Center"/>

                        <Button Style="{StaticResource PlainButton}" Padding="6,4,10,4" Click="Perfil_Click" ToolTip="Ver tu perfil">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="38" Height="38">
                                    <Ellipse Fill="{StaticResource AccentGradient}"/>
                                    <TextBlock x:Name="AvatarText" Text="{Binding Iniciales}" FontSize="14" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="12" Height="12"
                                             Fill="{StaticResource SuccessBrush}"
                                             Stroke="{StaticResource ChromeBrush}"
                                             StrokeThickness="2"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,-1,-1"/>
                                </Grid>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserNameText" Text="{Binding NombreVisible}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" Margin="0,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Jugando}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Panel de notificaciones -->
                    <Popup x:Name="PanelNotificaciones"
                           PlacementTarget="{Binding ElementName=Campana}"
                           Placement="Bottom"
                           HorizontalOffset="-336"
                           VerticalOffset="6"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Closed="PanelNotificaciones_Closed">
                        <Border Margin="16,0,16,24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.55"/>
                            </Border.Effect>
                            <Border Width="360" Background="#151926" BorderBrush="{StaticResource LineStrongBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Notificaciones" FontSize="16" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource PlainButton}" HorizontalAlignment="Right" Padding="8,3"
                                                Click="VerActividad_Click">
                                            <TextBlock Text="Ver toda la actividad" FontSize="12" Foreground="{StaticResource AccentLightBrush}"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Notificaciones}"
                                                  ItemTemplate="{StaticResource EntradaActividad}"/>

                                    <TextBlock Text="No tienes notificaciones."
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,10"
                                               Visibility="{Binding Notificaciones.Count, Converter={StaticResource VisibleSi}, ConverterParameter=no}"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Resplandor de fondo -->
            <Border Grid.Row="1" Height="420" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.3,0" GradientOrigin="0.3,0" RadiusX="0.6" RadiusY="1">
                        <GradientStop Color="#1A7C5CFC" Offset="0"/>
                        <GradientStop Color="#007C5CFC" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Vista de la sección actual -->
            <ContentControl x:Name="Contenido" Grid.Row="1" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="ContenidoDesplazamiento"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- Aviso flotante -->
            <Grid x:Name="Toast"
                  Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,32"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="18"/>
                </Grid.RenderTransform>

                <Border CornerRadius="14" Background="#1A1E2A">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>

                <Border CornerRadius="14" Background="#1A1E2A" BorderBrush="{StaticResource LineStrongBrush}"
                        BorderThickness="1" Padding="14,12,24,12" MaxWidth="520">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}">
                            <TextBlock x:Name="ToastIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Foreground="White"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitle" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="ToastText" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" MaxWidth="420" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
