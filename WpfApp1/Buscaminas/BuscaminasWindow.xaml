<Window x:Class="WpfApp1.Buscaminas.BuscaminasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:WpfApp1.Buscaminas"
        Title="Buscaminas — GameStation"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D12"
        Foreground="#F4F5F7"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- Casillas -->
        <LinearGradientBrush x:Key="TileBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2C3348" Offset="0"/>
            <GradientStop Color="#232939" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TileHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A4462" Offset="0"/>
            <GradientStop Color="#2E3650" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TilePressedBrush" Color="#1D2230"/>
        <SolidColorBrush x:Key="RevealedBrush" Color="#11141C"/>

        <!-- Una casilla del tablero. Su DataContext es una b:Celda. -->
        <Style x:Key="Casilla" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Margin="1.5"
                                CornerRadius="6"
                                Background="{StaticResource TileBrush}"
                                BorderBrush="#3D4660"
                                BorderThickness="0,1,0,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Numero"
                                           Text="{Binding MinasAlrededor}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="Bandera"
                                           Text="&#xE7C1;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15"
                                           Foreground="#FF5C7A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <!-- Mina dibujada con formas -->
                                <Grid x:Name="Mina"
                                      Width="20"
                                      Height="20"
                                      Visibility="Collapsed">
                                    <Path Data="M10,1 L10,19 M1,10 L19,10 M3.6,3.6 L16.4,16.4 M16.4,3.6 L3.6,16.4"
                                          Stroke="#D9DCE5"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Ellipse Width="13" Height="13" Fill="#D9DCE5"/>
                                    <Ellipse Width="4"
                                             Height="4"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Margin="6,6,0,0"/>
                                </Grid>

                                <TextBlock x:Name="Cruz"
                                           Text="&#xE711;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="18"
                                           Foreground="#FF5C7A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Casilla oculta -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource TilePressedBrush}"/>
                            </Trigger>

                            <!-- Según lo que haya en la casilla -->
                            <DataTrigger Binding="{Binding Vista}" Value="{x:Static b:VistaCelda.Bandera}">
                                <Setter TargetName="Bandera" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Vista}" Value="{x:Static b:VistaCelda.Vacia}">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource RevealedBrush}"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Vista}" Value="{x:Static b:VistaCelda.Numero}">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource RevealedBrush}"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Numero" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Vista}" Value="{x:Static b:VistaCelda.Mina}">
                                <Setter TargetName="Tile" Property="Background" Value="#1A1E2A"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Mina" Property="Visibility" Value="Visible"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Vista}" Value="{x:Static b:VistaCelda.MinaExplotada}">
                                <Setter TargetName="Tile" Property="Background" Value="#E5484D"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Mina" Property="Visibility" Value="Visible"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Vista}" Value="{x:Static b:VistaCelda.BanderaIncorrecta}">
                                <Setter TargetName="Bandera" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bandera" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Cruz" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- Colores de los números -->
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="1">
                                <Setter TargetName="Numero" Property="Foreground" Value="#60A5FA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="2">
                                <Setter TargetName="Numero" Property="Foreground" Value="#4ADE80"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="3">
                                <Setter TargetName="Numero" Property="Foreground" Value="#F87171"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="4">
                                <Setter TargetName="Numero" Property="Foreground" Value="#A78BFA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="5">
                                <Setter TargetName="Numero" Property="Foreground" Value="#FBBF24"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="6">
                                <Setter TargetName="Numero" Property="Foreground" Value="#22D3EE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="7">
                                <Setter TargetName="Numero" Property="Foreground" Value="#F472B6"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MinasAlrededor}" Value="8">
                                <Setter TargetName="Numero" Property="Foreground" Value="#CBD5E1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastilla del marcador (minas / tiempo) -->
        <Style x:Key="Marcador" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="MarcadorValor" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>


        <!-- ═══════════════════════ ZONA DE JUEGO ═══════════════════════ -->

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Resplandor de fondo -->
            <Border Grid.RowSpan="4" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#147C5CFC" Offset="0"/>
                        <GradientStop Color="#007C5CFC" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Cabecera -->
            <Grid Grid.Row="0" Margin="28,22,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="46" Height="46">
                        <Border CornerRadius="13" Background="{StaticResource PortadaBuscaminas}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF6A5E" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="20" Foreground="White"/>
                    </Grid>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Buscaminas" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="DificultadTexto"
                                   Text="Principiante · 9 × 9 · 10 minas"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Dificultades -->
                <StackPanel x:Name="Selector"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            RadioButton.Checked="Dificultad_Checked">
                    <RadioButton x:Name="ChipPrincipiante" Style="{StaticResource Chip}" GroupName="DificultadJuego"
                                 Content="Principiante" Tag="{x:Static b:Dificultad.Principiante}" Margin="0,0,8,0"
                                 ToolTip="9 × 9 · 10 minas (tecla 1)"/>
                    <RadioButton x:Name="ChipIntermedio" Style="{StaticResource Chip}" GroupName="DificultadJuego"
                                 Content="Intermedio" Tag="{x:Static b:Dificultad.Intermedio}" Margin="0,0,8,0"
                                 ToolTip="16 × 16 · 40 minas (tecla 2)"/>
                    <RadioButton x:Name="ChipExperto" Style="{StaticResource Chip}" GroupName="DificultadJuego"
                                 Content="Experto" Tag="{x:Static b:Dificultad.Experto}" Margin="0"
                                 ToolTip="30 × 16 · 99 minas (tecla 3)"/>
                </StackPanel>
            </Grid>

            <!-- Marcador -->
            <Grid Grid.Row="1" Margin="28,18,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Marcador}" ToolTip="Minas que faltan por marcar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="15" Foreground="#FF5C7A"/>
                        <TextBlock x:Name="MinasTexto" Text="010" Style="{StaticResource MarcadorValor}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Marcador}" ToolTip="Tiempo de la partida">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource AccentLightBrush}"/>
                        <TextBlock x:Name="TiempoTexto" Text="000" Style="{StaticResource MarcadorValor}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="EstadoPastilla"
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Padding="12,6"
                        Background="{StaticResource AccentSoftBrush}">
                    <TextBlock x:Name="EstadoTexto"
                               Text="Haz clic en una casilla para empezar"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentLightBrush}"/>
                </Border>

                <Button Grid.Column="3"
                        Style="{StaticResource PrimarySmallButton}"
                        Click="NuevaPartida_Click"
                        ToolTip="Empezar de nuevo (F2)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                        <TextBlock Text="Nueva partida" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Tablero -->
            <Border x:Name="Marco"
                    Grid.Row="2"
                    Margin="28,20,28,12"
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Sacudida"/>
                </Border.RenderTransform>

                <Viewbox x:Name="Escala" Stretch="Uniform">
                    <ItemsControl x:Name="TableroCasillas"
                                  Button.Click="Casilla_Click"
                                  PreviewMouseRightButtonDown="Casilla_ClicDerecho">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Columnas, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Casilla}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Border>

            <!-- Resultado (ganar / perder) -->
            <Grid x:Name="Resultado"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  Opacity="0">
                <Border Background="#CC0B0D12"/>

                <Border Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="28">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.6"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <Ellipse x:Name="ResultadoCirculo" Fill="{StaticResource SuccessSoftBrush}"/>
                            <TextBlock x:Name="ResultadoIcono"
                                       Text="&#xE735;"
                                       Style="{StaticResource Icon}"
                                       FontSize="26"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>

                        <TextBlock x:Name="ResultadoTitulo"
                                   Text="¡Has ganado!"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>

                        <TextBlock x:Name="ResultadoDetalle"
                                   Text=""
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <Border x:Name="RecordPastilla"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                Padding="12,5"
                                CornerRadius="12"
                                Background="#33FBBF24"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="12" Foreground="#FBBF24"/>
                                <TextBlock Text="¡Nuevo récord personal!"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FBBF24"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Logros conseguidos en esta partida -->
                        <ItemsControl x:Name="LogrosNuevos" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="12"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="32" Height="32">
                                                <Ellipse Fill="{StaticResource AccentGradient}"/>
                                                <TextBlock Text="{Binding Glifo}" Style="{StaticResource Icon}" FontSize="14" Foreground="White"/>
                                            </Grid>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Titulo, StringFormat='Logro: {0}'}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Descripcion}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="NuevaPartida_Click" Height="42">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                                    <TextBlock Text="Jugar otra vez" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}"
                                    Height="42"
                                    Margin="10,0,0,0"
                                    Content="Ver tablero"
                                    Click="VerTablero_Click"/>
                        </StackPanel>

                        <Button Style="{StaticResource PlainButton}"
                                HorizontalAlignment="Center"
                                Padding="10,6"
                                Margin="0,10,0,0"
                                Click="Salir_Click">
                            <TextBlock Text="Volver al launcher"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ayuda -->
            <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="28,0,28,18">
                <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </WrapPanel.Resources>
                <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0"/>
                <TextBlock Text="Clic: descubrir"/>
                <TextBlock Text="  ·  "/>
                <TextBlock Text="Clic derecho: bandera"/>
                <TextBlock Text="  ·  "/>
                <TextBlock Text="Clic en un número: despejar alrededor"/>
                <TextBlock Text="  ·  "/>
                <TextBlock Text="F2: nueva partida"/>
            </WrapPanel>
        </Grid>


        <!-- ═══════════════════════ PANEL DERECHO ═══════════════════════ -->

        <Border Grid.Column="1"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="#171A23"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,26,22,22">

                    <!-- Récord -->
                    <TextBlock Text="TU RÉCORD" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource Panel}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Ellipse Fill="#33FBBF24"/>
                                <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="18" Foreground="#FBBF24"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RecordTexto" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="RecordDificultad" Text="Mejor tiempo en Principiante" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Estadísticas -->
                    <TextBlock Text="ESTADÍSTICAS" Style="{StaticResource SectionLabel}" Margin="0,24,0,8"/>
                    <Border Style="{StaticResource Panel}" Padding="0">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="18,16">
                                <TextBlock x:Name="PartidasTexto" Text="0" Style="{StaticResource StatValue}" FontSize="20"/>
                                <TextBlock Text="Partidas" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel Margin="18,16">
                                <TextBlock x:Name="VictoriasTexto" Text="0" Style="{StaticResource StatValue}" FontSize="20"/>
                                <TextBlock Text="Victorias" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel Margin="18,0,18,16">
                                <TextBlock x:Name="PorcentajeTexto" Text="—" Style="{StaticResource StatValue}" FontSize="20"/>
                                <TextBlock Text="% de victorias" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel Margin="18,0,18,16">
                                <TextBlock Text="{Binding RachaActual}" Style="{StaticResource StatValue}" FontSize="20"/>
                                <TextBlock Text="Racha actual" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Logros -->
                    <Grid Margin="0,24,0,8">
                        <TextBlock Text="LOGROS" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Text="{Binding LogrosTexto}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource Panel}" Padding="16">
                        <StackPanel>
                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding LogrosPorcentaje, Mode=OneWay}"/>
                            <ItemsControl ItemsSource="{Binding Logros}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="44" Height="44" Margin="3" Background="Transparent">
                                            <Grid.ToolTip>
                                                <StackPanel MaxWidth="220">
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Opacity="0.8"/>
                                                    <TextBlock Text="{Binding FechaTexto}" Opacity="0.6" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid.ToolTip>
                                            <Ellipse x:Name="Fondo" Fill="#1C2130" Stroke="#2A3040" StrokeThickness="1"/>
                                            <TextBlock x:Name="Glifo"
                                                       Text="{Binding Glifo}"
                                                       Style="{StaticResource Icon}"
                                                       FontSize="16"
                                                       Foreground="#4A5266"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Desbloqueado}" Value="True">
                                                <Setter TargetName="Fondo" Property="Fill" Value="{StaticResource AccentGradient}"/>
                                                <Setter TargetName="Fondo" Property="Stroke" Value="Transparent"/>
                                                <Setter TargetName="Glifo" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Reglas -->
                    <TextBlock Text="CÓMO SE JUEGA" Style="{StaticResource SectionLabel}" Margin="0,24,0,8"/>
                    <Border Style="{StaticResource Panel}" Padding="16">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="LineHeight" Value="18"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="• Descubre todas las casillas que no tienen mina."/>
                            <TextBlock Text="• Cada número indica cuántas minas hay en las 8 casillas que lo rodean."/>
                            <TextBlock Text="• Marca con bandera (clic derecho) las casillas donde creas que hay una mina."/>
                            <TextBlock Text="• El primer clic nunca es una mina (puedes cambiarlo en Configuración)." Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
