<UserControl x:Class="WpfApp1.Vistas.InicioVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:WpfApp1.Buscaminas">

    <!-- Biblioteca: portada, "Continuar jugando" y todos los juegos. DataContext = Modelos.Launcher -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,48">

            <!-- SALUDO -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Saludo}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="¿A qué jugamos hoy? Esto es lo último de tu biblioteca." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentLightBrush}"/>
                        <TextBlock Text="{Binding FechaTexto}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>


            <!-- DESTACADO: BUSCAMINAS -->
            <Grid Height="300" Margin="0,24,0,0">

                <Border CornerRadius="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2B1F6B" Offset="0"/>
                            <GradientStop Color="#191338" Offset="0.55"/>
                            <GradientStop Color="#0F1B33" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="22">
                    <Border.Background>
                        <RadialGradientBrush Center="0.8,0.2" GradientOrigin="0.8,0.2" RadiusX="0.5" RadiusY="1">
                            <GradientStop Color="#80FF7A59" Offset="0"/>
                            <GradientStop Color="#00FF7A59" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="22">
                    <Border.Background>
                        <RadialGradientBrush Center="0.05,1" GradientOrigin="0.05,1" RadiusX="0.45" RadiusY="0.9">
                            <GradientStop Color="#337C5CFC" Offset="0"/>
                            <GradientStop Color="#007C5CFC" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="22" BorderThickness="1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.75*" MaxWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="44,0,16,0">

                        <Border HorizontalAlignment="Left"
                                Background="#1FFFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="11" Foreground="#FFD166"/>
                                <TextBlock Text="YA DISPONIBLE · GRATIS"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFE2D6"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Buscaminas"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,14,0,0"/>

                        <TextBlock Text="El clásico de siempre, renovado. Despeja el campo, bate tus récords y desbloquea los 8 logros."
                                   FontSize="15"
                                   Foreground="#C9C2DE"
                                   TextWrapping="Wrap"
                                   MaxWidth="460"
                                   HorizontalAlignment="Left"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="Jugar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14"/>
                                    <TextBlock Text="Jugar ahora" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="Tienda_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="14"/>
                                    <TextBlock Text="Explorar tienda" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="12.480 jugadores en línea"
                                       FontSize="12"
                                       Foreground="#B9B3D6"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="·" FontSize="12" Foreground="#6E6890" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="3 dificultades · 8 logros"
                                       FontSize="12"
                                       Foreground="#B9B3D6"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Portadas en abanico (se encogen si la ventana es estrecha) -->
                    <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                    <Grid Width="400" Height="250">

                        <Ellipse Width="250" Height="250" Stroke="#1AFFFFFF" StrokeThickness="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Ellipse Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#66FF7A59" Offset="0"/>
                                    <GradientStop Color="#00FF7A59" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Border Width="150" Height="200" CornerRadius="16"
                                Background="{StaticResource PortadaNeon}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,0,160,0" RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-10"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="12" Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="16" Background="{StaticResource CoverSheen}"/>
                                <Border CornerRadius="16" Background="{StaticResource CoverShade}"/>
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="50" Foreground="White" Opacity="0.9" Margin="0,0,0,30"/>
                                <StackPanel VerticalAlignment="Bottom" Margin="14">
                                    <TextBlock Text="NEON CITY" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Próximamente" FontSize="10" Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Width="150" Height="200" CornerRadius="16"
                                Background="{StaticResource PortadaEclipse}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="160,0,0,0" RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="10"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="12" Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="16" Background="{StaticResource CoverSheen}"/>
                                <Border CornerRadius="16" Background="{StaticResource CoverShade}"/>
                                <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="50" Foreground="White" Opacity="0.9" Margin="0,0,0,30"/>
                                <StackPanel VerticalAlignment="Bottom" Margin="14">
                                    <TextBlock Text="ECLIPSE" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Próximamente" FontSize="10" Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Buscaminas (clicable) -->
                        <Button Style="{StaticResource PlainButton}"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="Jugar_Click"
                                ToolTip="Jugar al Buscaminas">
                            <Border Width="160" Height="214" CornerRadius="18" Background="{StaticResource PortadaBuscaminas}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.6"/>
                                </Border.Effect>
                                <Grid>
                                    <Border CornerRadius="18" Background="{StaticResource CoverSheen}"/>
                                    <Border CornerRadius="18" Background="{StaticResource CoverShade}"/>
                                    <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="56" Foreground="White" Margin="0,0,0,30"/>
                                    <StackPanel VerticalAlignment="Bottom" Margin="16">
                                        <TextBlock Text="BUSCAMINAS" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Puzle · Clásico" FontSize="11" Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>
                    </Viewbox>
                </Grid>
            </Grid>


            <!-- CONTINUAR JUGANDO -->
            <StackPanel Margin="0,40,0,14">
                <TextBlock Text="Continuar jugando" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Elige dificultad y retoma tus partidas" Style="{StaticResource SectionSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource Panel}" Padding="18" DataContext="{Binding Buscaminas}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="96" Height="96">
                        <Border CornerRadius="16" Background="{Binding Portada}"/>
                        <Border CornerRadius="16" Background="{StaticResource CoverSheen}"/>
                        <TextBlock Text="{Binding Glifo}" Style="{StaticResource Icon}" FontSize="36" Foreground="White"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="SemiBold"/>
                            <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Instalado" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding UltimaSesion}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>

                        <!-- Datos del launcher (no del juego) -->
                        <WrapPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{Binding PartidasTotales}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Partidas" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{Binding VictoriasTotales}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Victorias" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{Binding MejorTiempoPredeterminadoTexto}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DificultadPredeterminadaTexto, StringFormat='Récord ({0})'}" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{Binding LogrosTexto}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Logros" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Click="Jugar_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14"/>
                                <TextBlock Text="Jugar" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource ToolbarButton}" Content="Principiante" Padding="10,0"
                                    Tag="{x:Static b:Dificultad.Principiante}" Click="JugarDificultad_Click"
                                    ToolTip="9 × 9 · 10 minas"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Intermedio" Padding="10,0" Margin="6,0"
                                    Tag="{x:Static b:Dificultad.Intermedio}" Click="JugarDificultad_Click"
                                    ToolTip="16 × 16 · 40 minas"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Experto" Padding="10,0"
                                    Tag="{x:Static b:Dificultad.Experto}" Click="JugarDificultad_Click"
                                    ToolTip="30 × 16 · 99 minas"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- BIBLIOTECA -->
            <Grid Margin="0,40,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tu biblioteca" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="9,2" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding JuegosVisibles}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Todos tus juegos en un solo lugar" Style="{StaticResource SectionSubtitle}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource ToolbarButton}"
                        VerticalAlignment="Bottom"
                        Click="Ordenar_Click"
                        ToolTip="Cambiar el orden de la biblioteca">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="13"/>
                        <TextBlock Text="Ordenar:" Margin="8,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OrdenTexto}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Categorías -->
            <WrapPanel x:Name="Categorias" ToggleButton.Checked="Categoria_Checked" Margin="0,0,0,12">
                <RadioButton Style="{StaticResource Chip}" GroupName="Categorias" Content="Todos" IsChecked="True"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Categorias" Content="Acción"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Categorias" Content="Aventura"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Categorias" Content="RPG"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Categorias" Content="Estrategia"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Categorias" Content="Indie"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="Categorias" Content="Puzle"/>
            </WrapPanel>

            <!-- Juegos -->
            <Grid SizeChanged="Rejilla_SizeChanged">
                <ItemsControl ItemsSource="{Binding Biblioteca}"
                              Margin="-8,0"
                              Button.Click="Juego_Click"
                              ItemContainerStyle="{StaticResource CardContainer}"
                              Visibility="{Binding SinResultados, Converter={StaticResource VisibleSi}, ConverterParameter=no}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columnas, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GameCard}" AutomationProperties.Name="{Binding Titulo}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,40,0,24"
                            Visibility="{Binding SinResultados, Converter={StaticResource VisibleSi}}">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <TextBlock Text="No encontramos ningún juego"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Prueba con otro nombre o elige otra categoría."
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
