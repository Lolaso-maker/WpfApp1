<UserControl x:Class="WpfApp1.Vistas.AmigosVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:WpfApp1.Modelos">

    <!-- Lista de amigos, retos y solicitudes. DataContext = Modelos.Launcher -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,48">

            <TextBlock Text="Amigos" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding AmigosConectados, StringFormat='{}{0} amigos conectados ahora. Rétales a una partida de Buscaminas.'}"
                       Style="{StaticResource PageSubtitle}"/>

            <!-- Añadir amigo -->
            <Border Style="{StaticResource Panel}" Margin="0,24,0,0" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="40" Height="40">
                        <Ellipse Fill="{StaticResource AccentSoftBrush}"/>
                        <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource AccentLightBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBox x:Name="NuevoAmigo"
                                 Style="{StaticResource InputBox}"
                                 Tag="Nombre de tu amigo…"
                                 MaxLength="30"
                                 KeyDown="NuevoAmigo_KeyDown"/>
                        <TextBlock x:Name="Error"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="2,6,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource PrimarySmallButton}" Click="Agregar_Click" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                            <TextBlock Text="Añadir amigo" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Filtro -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,8">
                <RadioButton Style="{StaticResource Chip}" GroupName="FiltroAmigos" Content="Todos" IsChecked="True" Checked="Todos_Checked"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="FiltroAmigos" Content="Conectados" Checked="Conectados_Checked"/>
            </StackPanel>

            <!-- Lista -->
            <ItemsControl ItemsSource="{Binding AmigosFiltrados}" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Tarjeta" Style="{StaticResource Panel}" Margin="6" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="44" Height="44">
                                    <Ellipse Fill="{Binding Color}" Opacity="0.9"/>
                                    <TextBlock Text="{Binding Iniciales}" FontSize="14" FontWeight="Bold" Foreground="#0B0D12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="Punto"
                                             Width="13"
                                             Height="13"
                                             Fill="#4A5266"
                                             Stroke="{StaticResource SurfaceBrush}"
                                             StrokeThickness="2.5"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,-2,-2"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="Detalle" Text="{Binding Detalle}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource ToolbarButton}"
                                        IsEnabled="{Binding PuedeInvitar}"
                                        Click="Invitar_Click"
                                        ToolTip="Retar a una partida de Buscaminas">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="12"/>
                                        <TextBlock Text="{Binding BotonTexto}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoAmigo.Jugando}">
                                <Setter TargetName="Punto" Property="Fill" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="Detalle" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoAmigo.EnLinea}">
                                <Setter TargetName="Punto" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoAmigo.Ausente}">
                                <Setter TargetName="Punto" Property="Fill" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EstaConectado}" Value="False">
                                <Setter TargetName="Tarjeta" Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
