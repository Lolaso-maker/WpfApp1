<UserControl x:Class="WpfApp1.Vistas.DescargasVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cola de descargas (simulada). DataContext = Modelos.Launcher -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,48">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Descargas" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding ResumenDescargasTexto}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource ToolbarButton}"
                        VerticalAlignment="Center"
                        Click="Todas_Click"
                        Visibility="{Binding HayDescargas, Converter={StaticResource VisibleSi}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BotonDescargasGlifo}" Style="{StaticResource Icon}" FontSize="12"/>
                        <TextBlock Text="{Binding BotonDescargasTexto}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- EN CURSO -->
            <TextBlock Text="EN CURSO Y EN COLA" Style="{StaticResource SectionLabel}" Margin="0,28,0,10"/>

            <ItemsControl ItemsSource="{Binding Descargas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Fila" Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="64" Height="64">
                                    <Border CornerRadius="12" Background="{Binding Portada}"/>
                                    <Border CornerRadius="12" Background="{StaticResource CoverSheen}"/>
                                    <TextBlock Text="{Binding Glifo}" Style="{StaticResource Icon}" FontSize="24" Foreground="White"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Contenido}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProgresoTexto}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ProgressBar x:Name="Barra"
                                                 Style="{StaticResource ThinProgress}"
                                                 Height="6"
                                                 Value="{Binding Progreso, Mode=OneWay}"
                                                 Margin="0,10,0,8"/>

                                    <Grid>
                                        <TextBlock Text="{Binding DetalleTexto}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse x:Name="Punto" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Velocidad" Text="{Binding VelocidadTexto}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Click="Pausa_Click" ToolTip="{Binding BotonTexto}">
                                        <TextBlock Text="{Binding BotonGlifo}" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="Cancelar_Click" ToolTip="Cancelar descarga" Margin="4,0,0,0">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding EstaDescargando}" Value="False">
                                <Setter TargetName="Punto" Property="Fill" Value="#4A5266"/>
                                <Setter TargetName="Barra" Property="Foreground" Value="#4A5266"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sin descargas -->
            <Border Style="{StaticResource Panel}"
                    Padding="28"
                    Visibility="{Binding HayDescargas, Converter={StaticResource VisibleSi}, ConverterParameter=no}">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="56" Height="56">
                        <Ellipse Fill="{StaticResource SuccessSoftBrush}"/>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource SuccessBrush}"/>
                    </Grid>
                    <TextBlock Text="Todo al día" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="No hay descargas pendientes." FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- COMPLETADAS -->
            <StackPanel Visibility="{Binding HayCompletadas, Converter={StaticResource VisibleSi}}">
                <Grid Margin="0,28,0,10">
                    <TextBlock Text="COMPLETADAS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PlainButton}" HorizontalAlignment="Right" Padding="10,4" Click="Limpiar_Click">
                        <TextBlock Text="Limpiar lista" FontSize="12" Foreground="{StaticResource AccentLightBrush}"/>
                    </Button>
                </Grid>

                <Border Style="{StaticResource Panel}" Padding="6">
                    <ItemsControl ItemsSource="{Binding DescargasCompletadas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="{StaticResource SuccessSoftBrush}"/>
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource SuccessBrush}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Contenido}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DetalleTexto}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
