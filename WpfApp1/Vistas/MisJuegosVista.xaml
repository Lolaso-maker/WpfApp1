<UserControl x:Class="WpfApp1.Vistas.MisJuegosVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Lista de todos los juegos con su estado. DataContext = Modelos.Launcher -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,48">

            <TextBlock Text="Mis juegos" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Todo lo que tienes en tu biblioteca y lo que está por llegar." Style="{StaticResource PageSubtitle}"/>

            <!-- Resumen -->
            <UniformGrid Columns="4" Margin="-8,24,-8,0">
                <Border Style="{StaticResource Panel}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="{Binding Juegos.Count}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="Juegos en la biblioteca" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="1" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="Listos para jugar" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="{Binding TiempoJugadoTexto}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="Tiempo jugado" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="{Binding CantidadDeseados}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="En tu lista de deseos" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tabla -->
            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,24,0,0">
                <StackPanel>

                    <!-- Cabecera -->
                    <Grid Margin="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Text="JUEGO"/>
                        <TextBlock Grid.Column="1" Text="ESTADO"/>
                        <TextBlock Grid.Column="2" Text="TIEMPO"/>
                        <TextBlock Grid.Column="3" Text="ÚLTIMA SESIÓN"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>

                    <ItemsControl ItemsSource="{Binding Juegos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Fila" Padding="20,12" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="52" Height="52">
                                                <Border CornerRadius="10" Background="{Binding Portada}"/>
                                                <Border CornerRadius="10" Background="{StaticResource CoverSheen}"/>
                                                <TextBlock Text="{Binding Glifo}" Style="{StaticResource Icon}" FontSize="20" Foreground="White"/>
                                            </Grid>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Generos}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border x:Name="Etiqueta"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="8"
                                                Padding="8,3"
                                                Background="#1C2130">
                                            <TextBlock x:Name="EtiquetaTexto"
                                                       Text="{Binding Estado}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding HorasTexto}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding UltimaSesion}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                        <!-- Acción -->
                                        <Grid Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimarySmallButton}"
                                                    Click="Jugar_Click"
                                                    Visibility="{Binding Jugable, Converter={StaticResource VisibleSi}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    <TextBlock Text="Jugar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ToolbarButton}"
                                                    Click="Deseado_Click"
                                                    Visibility="{Binding Jugable, Converter={StaticResource VisibleSi}, ConverterParameter=no}"
                                                    ToolTip="Añadir o quitar de tu lista de deseos">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Corazon" Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    <TextBlock x:Name="CorazonTexto" Text="Desear" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Fila" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fila" Property="Background" Value="#10FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Jugable}" Value="True">
                                        <Setter TargetName="Etiqueta" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                        <Setter TargetName="EtiquetaTexto" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EnListaDeseos}" Value="True">
                                        <Setter TargetName="Corazon" Property="Text" Value="&#xEB52;"/>
                                        <Setter TargetName="Corazon" Property="Foreground" Value="#FF7DB4"/>
                                        <Setter TargetName="CorazonTexto" Property="Text" Value="Deseado"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
