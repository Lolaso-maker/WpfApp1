<UserControl x:Class="WpfApp1.Vistas.TiendaVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tienda / destacados con lista de deseos. DataContext = Modelos.Launcher -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,48">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Destacados" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Lo más esperado de la tienda. Añade a tu lista de deseos los que quieras seguir."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="#2AFF7DB4"
                        CornerRadius="12"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB52;" Style="{StaticResource Icon}" FontSize="13" Foreground="#FF7DB4"/>
                        <TextBlock Text="{Binding CantidadDeseados, StringFormat='Lista de deseos: {0}'}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB3D4"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ofertas -->
            <Border CornerRadius="18" Padding="26,22" Margin="0,24,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3A1F5C" Offset="0"/>
                        <GradientStop Color="#1A1F3A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52">
                        <Ellipse Fill="#33FBBF24"/>
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="22" Foreground="#FBBF24"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Rebajas de otoño" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Hasta un 50 % de descuento en juegos seleccionados. El Buscaminas es gratis para siempre."
                                   FontSize="13"
                                   Foreground="#C9C2DE"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Juegos -->
            <Grid SizeChanged="Rejilla_SizeChanged" Margin="0,24,0,0">
                <ItemsControl ItemsSource="{Binding Juegos}" Margin="-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columnas, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tarjeta"
                                    Margin="8"
                                    CornerRadius="16"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border CornerRadius="15,15,0,0" Background="{Binding Portada}"/>
                                    <Border CornerRadius="15,15,0,0" Background="{StaticResource CoverSheen}"/>
                                    <Border CornerRadius="15,15,0,0" Background="{StaticResource CoverShade}"/>
                                    <TextBlock Text="{Binding Glifo}" Style="{StaticResource Icon}" FontSize="52" Foreground="White" Opacity="0.85"/>

                                    <Border x:Name="Oferta"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Padding="8,3"
                                            CornerRadius="6"
                                            Background="#E622A35A"
                                            Visibility="{Binding TieneDescuento, Converter={StaticResource VisibleSi}}">
                                        <TextBlock x:Name="OfertaTexto" Text="{Binding DescuentoTexto}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="16,14,16,16">
                                        <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Generos}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Descripcion}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Height="34"
                                                   LineHeight="17"
                                                   Margin="0,8,0,0"/>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrecioOriginalTexto}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextDecorations="Strikethrough"
                                                           Visibility="{Binding TieneDescuento, Converter={StaticResource VisibleSi}}"/>
                                                <TextBlock Text="{Binding PrecioTexto}" FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimarySmallButton}"
                                                    Click="Jugar_Click"
                                                    Visibility="{Binding Jugable, Converter={StaticResource VisibleSi}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    <TextBlock Text="Jugar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource ToolbarButton}"
                                                    Click="Deseado_Click"
                                                    Visibility="{Binding Jugable, Converter={StaticResource VisibleSi}, ConverterParameter=no}"
                                                    ToolTip="Añadir o quitar de tu lista de deseos">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Corazon" Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    <TextBlock x:Name="CorazonTexto" Text="Desear" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tarjeta" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding EnListaDeseos}" Value="True">
                                    <Setter TargetName="Corazon" Property="Text" Value="&#xEB52;"/>
                                    <Setter TargetName="Corazon" Property="Foreground" Value="#FF7DB4"/>
                                    <Setter TargetName="CorazonTexto" Property="Text" Value="Deseado"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Jugable}" Value="True">
                                    <Setter TargetName="Oferta" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Oferta" Property="Background" Value="#E6FF8A4C"/>
                                    <Setter TargetName="OfertaTexto" Property="Text" Value="GRATIS"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
