<UserControl x:Class="WpfApp1.Vistas.SoporteVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ayuda rápida. DataContext = Modelos.Launcher -->

    <UserControl.Resources>
        <Style x:Key="Tecla" TargetType="Border">
            <Setter Property="Background" Value="#1C2130"/>
            <Setter Property="BorderBrush" Value="#2E3445"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Linea" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,48">

            <TextBlock Text="Soporte" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Respuestas rápidas para sacarle partido a GameStation." Style="{StaticResource PageSubtitle}"/>

            <UniformGrid Columns="2" Margin="-8,24,-8,0">

                <!-- Cómo jugar -->
                <Border Style="{StaticResource Panel}" Margin="8" Padding="22">
                    <StackPanel>
                        <Grid Width="44" Height="44" HorizontalAlignment="Left">
                            <Ellipse Fill="{StaticResource PortadaBuscaminas}"/>
                            <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="17" Foreground="White"/>
                        </Grid>
                        <TextBlock Text="Cómo se juega al Buscaminas" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,14,0,10"/>
                        <TextBlock Text="1. Haz clic en una casilla para descubrirla. El primer clic siempre es seguro." Style="{StaticResource Linea}"/>
                        <TextBlock Text="2. Cada número indica cuántas minas hay en las 8 casillas que la rodean." Style="{StaticResource Linea}"/>
                        <TextBlock Text="3. Marca las minas con clic derecho. Si un número ya tiene todas sus banderas, haz clic en él para descubrir el resto." Style="{StaticResource Linea}"/>
                        <TextBlock Text="4. Ganas cuando descubres todas las casillas sin mina." Style="{StaticResource Linea}" Margin="0"/>
                    </StackPanel>
                </Border>

                <!-- Atajos -->
                <Border Style="{StaticResource Panel}" Margin="8" Padding="22">
                    <StackPanel>
                        <Grid Width="44" Height="44" HorizontalAlignment="Left">
                            <Ellipse Fill="{StaticResource AccentSoftBrush}"/>
                            <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource AccentLightBrush}"/>
                        </Grid>
                        <TextBlock Text="Atajos de teclado" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,14,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Resources>

                            <Border Style="{StaticResource Tecla}"><TextBlock Text="Ctrl + K" FontSize="12" Foreground="{StaticResource TextBrush}"/></Border>
                            <TextBlock Grid.Column="1" Text="Buscar en la biblioteca"/>

                            <Border Grid.Row="1" Style="{StaticResource Tecla}"><TextBlock Text="Esc" FontSize="12" Foreground="{StaticResource TextBrush}"/></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Vaciar la búsqueda"/>

                            <Border Grid.Row="2" Style="{StaticResource Tecla}"><TextBlock Text="F2" FontSize="12" Foreground="{StaticResource TextBrush}"/></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Nueva partida (en el juego)"/>

                            <Border Grid.Row="3" Style="{StaticResource Tecla}"><TextBlock Text="1 · 2 · 3" FontSize="12" Foreground="{StaticResource TextBrush}"/></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Cambiar de dificultad (en el juego)"/>

                            <Border Grid.Row="4" Style="{StaticResource Tecla}"><TextBlock Text="Clic derecho" FontSize="12" Foreground="{StaticResource TextBrush}"/></Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Poner o quitar bandera"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Logros -->
                <Border Style="{StaticResource Panel}" Margin="8" Padding="22">
                    <StackPanel>
                        <Grid Width="44" Height="44" HorizontalAlignment="Left">
                            <Ellipse Fill="#33FBBF24"/>
                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="17" Foreground="#FBBF24"/>
                        </Grid>
                        <TextBlock Text="Logros y nivel" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,14,0,10"/>
                        <TextBlock Text="Cada partida suma experiencia: +10 XP por jugar, +25 XP por ganar y +50 XP por cada logro. Cada 150 XP subes de nivel."
                                   Style="{StaticResource Linea}"/>
                        <TextBlock Text="Hay 8 logros: algunos son fáciles y otros, como ganar en Experto o ganar sin banderas, son todo un reto."
                                   Style="{StaticResource Linea}" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Click="Perfil_Click" Content="Ver mis logros"/>
                    </StackPanel>
                </Border>

                <!-- Datos -->
                <Border Style="{StaticResource Panel}" Margin="8" Padding="22">
                    <StackPanel>
                        <Grid Width="44" Height="44" HorizontalAlignment="Left">
                            <Ellipse Fill="#2A22D3EE"/>
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="17" Foreground="#22D3EE"/>
                        </Grid>
                        <TextBlock Text="Tus datos" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,14,0,10"/>
                        <TextBlock Text="Tus estadísticas, logros, ajustes y lista de deseos se guardan en tu equipo, en un archivo por usuario."
                                   Style="{StaticResource Linea}"/>
                        <TextBlock Text="Las descargas, la tienda y los amigos son una demostración del launcher: el único juego que se puede jugar es el Buscaminas."
                                   Style="{StaticResource Linea}" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Click="Ajustes_Click" Content="Abrir configuración"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Llamada a la acción -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="¿Listo para probar?" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Abre el Buscaminas con tu dificultad predeterminada." Style="{StaticResource SectionSubtitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="Jugar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14"/>
                            <TextBlock Text="Jugar al Buscaminas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
