<UserControl x:Class="WpfApp1.Vistas.AjustesVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Configuración (se guarda automáticamente). DataContext = Modelos.Launcher -->

    <UserControl.Resources>
        <Style x:Key="AjusteTitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="AjusteTexto" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,48" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Configuración" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Los cambios se guardan automáticamente." Style="{StaticResource PageSubtitle}"/>

            <!-- CUENTA -->
            <TextBlock Text="CUENTA" Style="{StaticResource SectionLabel}" Margin="0,28,0,10"/>
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="48" Height="48">
                        <Ellipse Fill="{StaticResource AccentGradient}"/>
                        <TextBlock Text="{Binding Iniciales}" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NombreVisible}" Style="{StaticResource AjusteTitulo}"/>
                        <TextBlock Text="{Binding Usuario, StringFormat='Sesión iniciada como «{0}»'}" Style="{StaticResource AjusteTexto}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource DangerButton}" Click="CerrarSesion_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="12"/>
                            <TextBlock Text="Cerrar sesión" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- GENERAL -->
            <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" Margin="0,28,0,10"/>
            <Border Style="{StaticResource Panel}" Padding="0">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="20,18" IsChecked="{Binding MostrarAvisos}">
                        <StackPanel>
                            <TextBlock Text="Avisos emergentes" Style="{StaticResource AjusteTitulo}"/>
                            <TextBlock Text="Muestra un aviso abajo cuando terminas una descarga, consigues un logro o un amigo responde."
                                       Style="{StaticResource AjusteTexto}"/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="20,18" IsChecked="{Binding Sonidos}">
                        <StackPanel>
                            <TextBlock Text="Sonidos" Style="{StaticResource AjusteTitulo}"/>
                            <TextBlock Text="Reproduce un sonido del sistema al ganar o perder una partida."
                                       Style="{StaticResource AjusteTexto}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- BUSCAMINAS -->
            <TextBlock Text="BUSCAMINAS" Style="{StaticResource SectionLabel}" Margin="0,28,0,10"/>
            <Border Style="{StaticResource Panel}" Padding="0">
                <StackPanel>
                    <StackPanel Margin="20,18">
                        <TextBlock Text="Dificultad predeterminada" Style="{StaticResource AjusteTitulo}"/>
                        <TextBlock Text="La que se usa al pulsar «Jugar» desde el launcher."
                                   Style="{StaticResource AjusteTexto}"/>
                        <WrapPanel Margin="0,12,0,-8">
                            <RadioButton Style="{StaticResource Chip}" GroupName="DificultadPredeterminada" Content="Principiante"
                                         IsChecked="{Binding DificultadPredeterminada, Converter={StaticResource EnumABool}, ConverterParameter=Principiante}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="DificultadPredeterminada" Content="Intermedio"
                                         IsChecked="{Binding DificultadPredeterminada, Converter={StaticResource EnumABool}, ConverterParameter=Intermedio}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="DificultadPredeterminada" Content="Experto"
                                         IsChecked="{Binding DificultadPredeterminada, Converter={StaticResource EnumABool}, ConverterParameter=Experto}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="20,18" IsChecked="{Binding PrimerClicSeguro}">
                        <StackPanel>
                            <TextBlock Text="Primer clic seguro" Style="{StaticResource AjusteTitulo}"/>
                            <TextBlock Text="La primera casilla que pulses (y las de alrededor) nunca tendrán mina. Se aplica a la siguiente partida."
                                       Style="{StaticResource AjusteTexto}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- DATOS -->
            <TextBlock Text="DATOS" Style="{StaticResource SectionLabel}" Margin="0,28,0,10"/>
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Restablecer estadísticas" Style="{StaticResource AjusteTitulo}"/>
                        <TextBlock Text="Borra tus partidas, récords y logros del Buscaminas. Tus ajustes y amigos se mantienen."
                                   Style="{StaticResource AjusteTexto}"/>
                        <TextBlock x:Name="RutaDatos" Style="{StaticResource AjusteTexto}" Margin="0,8,0,0" Opacity="0.8"/>
                    </StackPanel>
                    <Button x:Name="BotonRestablecer"
                            Grid.Column="1"
                            Style="{StaticResource DangerButton}"
                            Click="Restablecer_Click"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                            <TextBlock x:Name="TextoRestablecer" Text="Restablecer" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
